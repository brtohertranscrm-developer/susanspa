# ImageKit untuk upload media. Kosong tidak apa-apa untuk dev lokal, tetapi upload foto akan ditolak.
# Private key dari dashboard ImageKit (Developer options). Jangan di-commit.
IMAGEKIT_PRIVATE_KEY=
# URL endpoint, bentuknya https://ik.imagekit.io/<id_imagekit>/
IMAGEKIT_URL_ENDPOINT=
